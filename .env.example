# Copy to .env and fill in. Never commit .env.

# WhatsApp Cloud API (Meta Business Manager > WhatsApp > API Setup)
WA_ACCESS_TOKEN=            # system-user permanent token; leave empty for dry-run (logs only)
WA_PHONE_NUMBER_ID=
WA_APP_SECRET=              # App settings > Basic > App secret (verifies webhook signatures)
WA_VERIFY_TOKEN=            # any long random string; paste the same value into Meta's webhook setup

# LLM: "anthropic" = Claude API (set ANTHROPIC_API_KEY); "bedrock" = AWS Bedrock (IAM role)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_EFFORT=low
AWS_REGION=ap-south-1

# Must be set before go-live
HOSPITAL_NAME=VPS Lakeshore
EMERGENCY_PHONE=
FRONT_DESK_PHONE=
PRIVACY_NOTICE_URL=
REPORT_PICKUP_NOTE=

# Data
KNOWLEDGE_DIR=knowledge     # use examples/knowledge to try the sample documents
STAFF_DIRECTORY_CSV=data/staff_directory.csv
HIS_ADAPTER=mock            # switch to "elider" once the Datamate integration is built
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+psycopg://bot:bot@postgres:5432/bot
AUDIT_HASH_SECRET=          # long random string
